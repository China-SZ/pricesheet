# Cookie encryption password — use a long random string (32+ chars)
# This is NOT the admin login password.
SESSION_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# Optional brand overrides
NEXT_PUBLIC_SITE_NAME=PriceSheet
NEXT_PUBLIC_SITE_TAGLINE=Online Price Spreadsheet

# Behind Caddy on production, use 127.0.0.1
PORT=3000
HOSTNAME=127.0.0.1

# Public domain is set at install time, not here:
#   DOMAIN=example.com sudo -E ./deploy/install-ubuntu.sh ...
